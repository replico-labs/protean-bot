# Get this from BotFather after /newbot - see the "how do I create my bot" walkthrough
TELEGRAM_BOT_TOKEN=

# Monad Testnet - public RPC, no key needed for reads
RPC_URL=https://testnet-rpc.monad.xyz

# ---------------------------------------------------------------------
# Networks. Every variable in this file without a prefix belongs to Monad
# testnet (the default). Other networks use the same names with a prefix:
#   monad-mainnet    MONAD_MAINNET_    (chain 143)
#   base             BASE_             (chain 8453)
#   base-sepolia     BASE_SEPOLIA_     (chain 84532)
#   hyperevm         HYPEREVM_         (chain 999)
#   hyperevm-testnet HYPEREVM_TESTNET_ (chain 998)
# e.g. BASE_RPC_URL, BASE_FACTORY_ADDRESS, BASE_QUADRATIC_FACTORY_ADDRESS,
# BASE_SORTITION_RANDOMNESS_SOURCE, BASE_PYTH_PRICE_ADAPTER.
# RPC_URL is optional per network (viem's public RPC otherwise).
#
# Which networks people may create/link DAOs on, comma separated. The
# default network is always included. Fund OPERATOR_PRIVATE_KEY's address
# on every network listed here - it pays gas and user top-ups on each.
NETWORKS=monad-testnet
# DEFAULT_NETWORK=monad-testnet
#
# Optional per-network overrides (defaults in src/networks.js):
#   <PREFIX>_GAS_MIN_BALANCE / _GAS_TOPUP_FIRST / _GAS_TOPUP_REPEAT
#     user-wallet gas in the native token: FIRST is sent when a wallet is
#     created, REPEAT is the smallest top-up when a transaction's up-front
#     cost exceeds the balance (a bigger shortfall gets 2x it). Defaults: Monad
#     0.005/0.1/0.05 MON, Base 0.00002/0.0002/0.0001 ETH,
#     HyperEVM 0.001/0.01/0.005 HYPE.
#   <PREFIX>_BLOCK_TIME_MS - used to scale block-counted voting periods
#     (Monad 400, Base 2000, HyperEVM 1000).
# Example:
# BASE_RPC_URL=https://mainnet.base.org
# BASE_FACTORY_ADDRESS=

# Needed for /createdao. Get this from DeployDAOFactory.s.sol's output.
FACTORY_ADDRESS=0x8bB68e835032e58c410125e5219B8Ae7FcAcc056

# One factory address per other model - /createdao <name> <symbol>
# <initialSupply> <maxSupply> [model] uses whichever is set for the
# requested model. Get each from that model's own Deploy<Model>DAOFactory.s.sol
# output. A model with no address set here simply can't be created
# through /createdao yet - existing DAOs of that model can still be
# linked with /register regardless.
QUADRATIC_FACTORY_ADDRESS=0x9d109ba81002B85a48252115Ed5487F6b60C78F9
LIQUID_FACTORY_ADDRESS=0x55C89331FA2F6a71E375c6C2aAf9BbE5b9b17fFe
OPTIMISTIC_FACTORY_ADDRESS=0x8F5a20c910aEbF287790e04799Ce0DB677705674
DELEGATE_FACTORY_ADDRESS=0x3fFb77D2A380C52e04b8d22E73EDc7d47e8f975c
BOARD_FACTORY_ADDRESS=0x2367d102B71ab6c3c3b69eD7580c3Be3ACb5BE9A
SORTITION_FACTORY_ADDRESS=0x251b2371e2E98b5db9A2ceF3B687dF1A93BD24E6

# The randomness source every new Sortition DAO gets wired to when
# created via /createdao: this network's PythEntropyRandomnessAdapter
# (Spaces: script/DeployPythEntropyAdapter.s.sol). Without it,
# /createdao sortition is unavailable - the bot won't guess an address.
SORTITION_RANDOMNESS_SOURCE=0x422cbB19F504D57cB909AC149e97f48Ba8c1b92D

# This network's PythPriceFeedAdapter (Spaces:
# script/DeployPythPriceFeedAdapter.s.sol) - what oracle=pyth means in
# /proposeaction and /proposecriteria for Sowellian DAOs. One deployment
# serves every Pyth feed; the feed ID is given per proposal.
PYTH_PRICE_ADAPTER=0x6C582533290855Af7F95d4484A6bb2e8C317949e
CONVICTION_FACTORY_ADDRESS=0x14439Fa27258c8fd65F5805eA5617774891f173c
SOWELLIAN_FACTORY_ADDRESS=0x075289669Ab8601dd8b15D95551644D511949056
DECISION_MARKETS_FACTORY_ADDRESS=0x99DeC80E792f9C1fA92F46fe08c6763CBCCfE388

# Base Sepolia (add base-sepolia to NETWORKS to enable it). Deployed with
# Spaces' size-limited profile; addresses as in Spaces' README.
# BASE_SEPOLIA_FACTORY_ADDRESS=0x72648d7954877Dadd9B38D71EE3C70e245D29B3a
# BASE_SEPOLIA_QUADRATIC_FACTORY_ADDRESS=0xd85923722591C005a23840Cd95B6888ABD11a345
# BASE_SEPOLIA_LIQUID_FACTORY_ADDRESS=0x10F551fF56455366AE7E9D3c3BBc96c9f058E821
# BASE_SEPOLIA_OPTIMISTIC_FACTORY_ADDRESS=0x2367d102B71ab6c3c3b69eD7580c3Be3ACb5BE9A
# BASE_SEPOLIA_DELEGATE_FACTORY_ADDRESS=0x5107BEfC0fEbE1E16bb8F408768bc5FF9F872658
# BASE_SEPOLIA_BOARD_FACTORY_ADDRESS=0x0be87f0Cf85dbfE6dc572eb4E2FD1FD46e96F475
# BASE_SEPOLIA_SORTITION_FACTORY_ADDRESS=0x14439Fa27258c8fd65F5805eA5617774891f173c
# BASE_SEPOLIA_CONVICTION_FACTORY_ADDRESS=0x3fFb77D2A380C52e04b8d22E73EDc7d47e8f975c
# BASE_SEPOLIA_SOWELLIAN_FACTORY_ADDRESS=0x55C89331FA2F6a71E375c6C2aAf9BbE5b9b17fFe
# BASE_SEPOLIA_DECISION_MARKETS_FACTORY_ADDRESS=0x801883FD3347e5F400fF8CE24015D60449f26dAf
# BASE_SEPOLIA_SORTITION_RANDOMNESS_SOURCE=0xaB7325AFfF2A7851457c52565Cfe4DC53DC9B1Fc
# BASE_SEPOLIA_PYTH_PRICE_ADAPTER=0x9d109ba81002B85a48252115Ed5487F6b60C78F9

# HyperEVM testnet (add hyperevm-testnet to NETWORKS to enable it).
# Deployed with Spaces' size-limited profile; addresses as in Spaces'
# README. The public RPC rate-limits hard - set a provider endpoint.
# HYPEREVM_TESTNET_RPC_URL=
# HYPEREVM_TESTNET_FACTORY_ADDRESS=0x0be87f0Cf85dbfE6dc572eb4E2FD1FD46e96F475
# HYPEREVM_TESTNET_QUADRATIC_FACTORY_ADDRESS=0xe61C9d371D3BEA6ceA5359E745593D8ebB39BEC5
# HYPEREVM_TESTNET_LIQUID_FACTORY_ADDRESS=0xd85923722591C005a23840Cd95B6888ABD11a345
# HYPEREVM_TESTNET_OPTIMISTIC_FACTORY_ADDRESS=0x5107BEfC0fEbE1E16bb8F408768bc5FF9F872658
# HYPEREVM_TESTNET_DELEGATE_FACTORY_ADDRESS=0x10F551fF56455366AE7E9D3c3BBc96c9f058E821
# HYPEREVM_TESTNET_BOARD_FACTORY_ADDRESS=0xcabF9a1c3e3e54715c52dfB45ae1AB7E1C3D3606
# HYPEREVM_TESTNET_SORTITION_FACTORY_ADDRESS=0x867b9e9edD9dE98979c9C6a82EEc363B077B96De
# HYPEREVM_TESTNET_CONVICTION_FACTORY_ADDRESS=0xBF49Fc7a3788c0CA53420ee6ccDA4aD9C5457362
# HYPEREVM_TESTNET_SOWELLIAN_FACTORY_ADDRESS=0xa9356ccA371D3b91a82f1fee3898E8ef444E512E
# HYPEREVM_TESTNET_DECISION_MARKETS_FACTORY_ADDRESS=0xAe322E1265530C58b03a2C36ab085500B9bc6624
# HYPEREVM_TESTNET_SORTITION_RANDOMNESS_SOURCE=0xeEdE1CBa9f2A86AEB145a71167ee2020396C3BD3
# HYPEREVM_TESTNET_PYTH_PRICE_ADAPTER=0x801883FD3347e5F400fF8CE24015D60449f26dAf

# Proposal pages (optional): the website that shows each proposal's page,
# and a long random secret the bot signs proposers' edit links with. Also
# create the proposal_details table (supabase/schema.sql). Leave unset to
# turn proposal pages off.
# PROPOSAL_SITE_URL=https://yoursite.com
# PROPOSAL_LINK_SECRET=

# Pyth's Hermes price service, which the bot fetches signed price
# updates from before resolving a Sowellian oracle proposal. Since Pyth's
# Core upgrade (26 Aug 2026) Hermes needs an API key: sign up at Pyth
# Terminal and copy the key. One key serves every network.
PYTH_API_KEY=
# Optional. Defaults to https://pyth.dourolabs.app/hermes.
# PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
#
# The sortition keeper (npm run keeper:sortition) finalizes rounds once
# Pyth Entropy has delivered. Each keeper process serves one network:
# KEEPER_NETWORK=base. Defaults to the default network.
# KEEPER_NETWORK=monad-testnet

# Private key for the bot's operator wallet - needed for /claim,
# auto-distribution on join, /createdao, and gas-funding user wallets
# (all write actions). Bot runs fine in read-only mode without this set.
# Fund this wallet with the native token on every enabled network - it also sponsors small gas top-ups for
# every user wallet's first transaction. Never commit a real key - this is
# read from .env, which is gitignored.
OPERATOR_PRIVATE_KEY=

# ⚠️ LEGACY. Used to deterministically derive a user's wallet from their
# Telegram ID - being replaced by KMS_KEY_ID + SUPABASE_* below. Keep this
# set for now if any existing users already have funds in derived
# wallets; new wallet creation should move to the KMS-backed system.
# Anyone who obtains this can derive and control every user's private
# key under the old system - treat it with more care than
# OPERATOR_PRIVATE_KEY. Never commit it, never log it, never share it.
MASTER_WALLET_SEED=

# KMS-backed wallet system (replaces MASTER_WALLET_SEED for new wallets).
# One symmetric key in AWS KMS, used to envelope-encrypt each user's
# independently-generated private key - see src/kmsWallet.js for the full
# design rationale. Create a symmetric KMS key in the AWS Console (KMS >
# Create key > Symmetric > Encrypt and decrypt) and paste its Key ID here.
KMS_KEY_ID=
AWS_REGION=us-east-1
# Also needs standard AWS credentials available to the process (e.g.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or an attached IAM role if
# hosted on AWS) - the KMS SDK reads these the normal AWS SDK way, not
# through a separate variable here.

# Durable storage for KMS-backed wallet records (Supabase = managed
# Postgres). Run supabase/schema.sql once in your project's SQL editor
# before setting these. Use the service_role key, not the anon key - this
# table has Row Level Security enabled with no permissive policies, so
# only the service_role key can read or write it at all.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: your own RPC endpoint (Alchemy/QuickNode/etc) if the public one
# rate-limits you once the bot is under real load
# RPC_URL=https://your-provider-endpoint

# Opportunity Markets targets Ethereum Sepolia, not Monad - a completely
# separate network from everything else in this bot. Falls back to
# viem's public default Sepolia RPC if unset, which works for quick
# testing but will rate-limit fast under real load - same as RPC_URL
# above, just for this one feature's own network.
OPPORTUNITY_MARKET_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Needed for /createmarket - the already-deployed OpportunityMarketFactory
# on Sepolia. Without this, /createmarket is unavailable, but
# /registermarket still works for linking an already-deployed market.
OPPORTUNITY_MARKET_FACTORY_ADDRESS=0xE9fF23EA5FE342568B5Db083E937f397C75c4625

# ---------------------------------------------------------------------
# Discord (optional, npm run discord). From the Discord Developer Portal:
# Application ID (General Information) and Bot -> Reset Token. Invite the
# bot with the "bot" and "applications.commands" scopes.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register commands to one server instantly while testing
# (global registration can take up to an hour to appear).
DISCORD_GUILD_ID=

# Slack (optional, npm run slack). Create the app from
# docs/slack-app-manifest.yml; see the comments there for each value.
# Always needed: the app-level token (xapp-..., connections:write).
SLACK_APP_TOKEN=
# Any workspace can install via "Add to Slack" (public distribution):
# set these four. Tokens are then stored per workspace, encrypted, in
# Supabase (needs SUPABASE_* and KMS_KEY_ID, and the slack_installations
# table from supabase/schema.sql). SLACK_BOT_TOKEN is then ignored.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Any long random string (e.g. `openssl rand -hex 32`); signs the OAuth state.
SLACK_STATE_SECRET=
# The bot's public HTTPS address, e.g. https://protean-bot.up.railway.app
# Install link: <SLACK_PUBLIC_URL>/slack/install
SLACK_PUBLIC_URL=
# Port for that install page; defaults to PORT (set by Railway), then 3000.
SLACK_INSTALL_PORT=
# Single workspace only, instead of the four above: its bot token (xoxb-...).
SLACK_BOT_TOKEN=

# WhatsApp (optional, npm run whatsapp). Link the bot's number one of two ways:
# - QR: set a long random secret (e.g. `openssl rand -hex 32`), open
#   https://<bot domain>/whatsapp/link?key=<secret> on another screen and
#   scan it from the bot's phone under Linked devices > Link a device.
WHATSAPP_LINK_SECRET=
# - Pairing code: the bot's number, digits only with country code (e.g.
#   2348012345678); the logs print a code to enter under Link a device >
#   Link with phone number instead. When set, it's used instead of the QR.
WHATSAPP_PHONE_NUMBER=
# Where the linked session is saved; must be on the persistent volume.
# Default data/whatsapp-auth.
WHATSAPP_AUTH_DIR=
# Running WhatsApp as its own Railway service (its own container and volume,
# start command `npm run whatsapp`): set this on that service only. It then
# serves the QR link page itself on its own domain; remove WHATSAPP_LINK_SECRET
# from the main service.
# WHATSAPP_STANDALONE=true

# OpenSea actions (/proposeaction opensea-*): free API key from
# opensea.io/settings/developer. Used to read collection fees when listing
# and to fetch the listing to fill when buying (listings themselves go
# on-chain via Seaport.validate). Not needed for anything else.
# OPENSEA_API_KEY=

# --- Solana (Vortexes) ---------------------------------------------------
# Solana DAOs run on the Vortexes programs (github.com/replico-labs/Vortexes).
# Off unless SOLANA_ENABLED=true: with it unset nothing changes for anyone.
# Before turning it on, run supabase/schema.sql again (it adds the
# wallets.solana column that holds each user's Solana wallet).
# SOLANA_ENABLED=true
#
# The bot's Solana wallet: creates DAOs, pays for queue/execute/finalize
# steps, elections and applying model switches, and tops up users' SOL for
# fees and rent. A base58 private key (Phantom's export) or a
# solana-keygen file's JSON byte array. Fund it with SOL on each cluster.
# SOLANA_OPERATOR_KEY=
#
# Optional. RPC (public devnet RPC otherwise - rate-limited; a provider URL
# is better), and program IDs (default: the Vortexes devnet deployment).
# SOLANA_DEVNET_RPC_URL=
# SOLANA_DEVNET_HUB_PROGRAM_ID= / _TOKEN_WEIGHTED_PROGRAM_ID= / _QUADRATIC_PROGRAM_ID=
#   / _OPTIMISTIC_PROGRAM_ID= / _BOARD_PROGRAM_ID= / _CONVICTION_PROGRAM_ID= / _DELEGATE_PROGRAM_ID=
#
# User SOL top-ups, in SOL (defaults 0.01 minimum, 0.03 first, 0.02 later):
# SOLANA_DEVNET_TOPUP_MIN= / SOLANA_DEVNET_TOPUP_FIRST= / SOLANA_DEVNET_TOPUP_REPEAT=
#
# Devnet testing only, for new DAOs: 2-minute votes, challenge windows and
# election phases, 30-second timelocks, 10-minute council terms, and
# conviction that reaches a bar of 20% of supply in about 2 minutes.
# SOLANA_DEVNET_FAST_TIMINGS=true
